include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/manifest.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/windows_sdk_tools.cmake")

# Read PE imports without loading or copying binaries. Generate one assembly
# manifest per DLL and an application manifest with its direct dependencies.
function(gen_runtime_manifests)
    cmake_parse_arguments(ARG ""
        "EXECUTABLE;NAME;VERSION;OUTPUT_DIRECTORY;LIBRARY_DIRECTORY;OBJDUMP"
        "DIRECTORIES;LOCAL_LIBRARIES;VERSIONS" ${ARGN})
    if(NOT WIN32)
        message(FATAL_ERROR "gen_runtime_manifests() is supported only on Windows")
    endif()
    foreach(required EXECUTABLE NAME VERSION OUTPUT_DIRECTORY LIBRARY_DIRECTORY)
        if(NOT ARG_${required})
            message(FATAL_ERROR "gen_runtime_manifests() requires ${required}")
        endif()
    endforeach()
    if(NOT ARG_OBJDUMP)
        find_program(ARG_OBJDUMP NAMES llvm-objdump objdump REQUIRED)
    endif()

    foreach(entry IN LISTS ARG_VERSIONS)
        if(NOT entry MATCHES "^([^:]+):(.+)$")
            message(FATAL_ERROR "Invalid runtime version '${entry}'; expected 'filename:version'")
        endif()
        string(TOLOWER "${CMAKE_MATCH_1}" name)
        set(version "${CMAKE_MATCH_2}")
        string(SHA256 id "${name}")
        set(version_${id} "${version}")
    endforeach()
    set(local_libraries "")
    foreach(name IN LISTS ARG_LOCAL_LIBRARIES)
        string(TOLOWER "${name}" name)
        list(APPEND local_libraries "${name}")
    endforeach()

    set(queue "${ARG_EXECUTABLE}")
    set(modules "")
    while(queue)
        list(POP_FRONT queue binary)
        get_filename_component(name "${binary}" NAME)
        string(TOLOWER "${name}" key)
        string(SHA256 id "${key}")
        if(id IN_LIST modules)
            continue()
        endif()
        list(APPEND modules "${id}")
        set(name_${id} "${name}")
        set(path_${id} "${binary}")
        set(imports_${id} "")
        execute_process(COMMAND "${ARG_OBJDUMP}" -p "${binary}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Could not inspect ${binary}: ${error}")
        endif()
        string(REGEX MATCHALL "DLL Name:[ \t]+[^\r\n]+" imports "${output}")
        foreach(import IN LISTS imports)
            string(REGEX REPLACE "^DLL Name:[ \t]+" "" import "${import}")
            string(STRIP "${import}" import)
            string(TOLOWER "${import}" import_key)
            if(import_key MATCHES "^(api-ms-win-|ext-ms-win-)")
                continue()
            endif()
            if(import_key IN_LIST local_libraries)
                set(directories "${ARG_LIBRARY_DIRECTORY}" ${ARG_DIRECTORIES})
            else()
                set(directories ${ARG_DIRECTORIES} "${ARG_LIBRARY_DIRECTORY}")
            endif()
            set(resolved "")
            foreach(directory IN LISTS directories)
                if(EXISTS "${directory}/${import}")
                    set(resolved "${directory}/${import}")
                    break()
                endif()
            endforeach()
            if(resolved)
                string(SHA256 child "${import_key}")
                list(APPEND imports_${id} "${child}")
                list(APPEND queue "${resolved}")
            elseif(NOT EXISTS "$ENV{SystemRoot}/System32/${import}")
                message(FATAL_ERROR "Unresolved runtime import: ${binary} -> ${import}")
            endif()
        endforeach()
        list(REMOVE_DUPLICATES imports_${id})
    endwhile()

    list(GET modules 0 executable_id)
    foreach(id IN LISTS modules)
        if(id STREQUAL executable_id)
            continue()
        endif()
        if(NOT DEFINED version_${id})
            get_windows_dll_file_version("${path_${id}}" version_${id} OPTIONAL)
        endif()
        if(NOT version_${id})
            # A private assembly still needs an identity when the DLL has no
            # version resource. Bind that identity to the exact binary bytes.
            file(SHA256 "${path_${id}}" digest)
            set(parts "")
            foreach(offset 0 4 8 12)
                string(SUBSTRING "${digest}" ${offset} 2 low)
                math(EXPR high_offset "${offset} + 2")
                string(SUBSTRING "${digest}" ${high_offset} 2 high)
                math(EXPR part "0x${high}${low}")
                list(APPEND parts "${part}")
            endforeach()
            list(JOIN parts "." version_${id})
        endif()
    endforeach()

    set(APP_LIB_DIR "${ARG_LIBRARY_DIRECTORY}")
    foreach(id IN LISTS modules)
        set(dependencies "")
        foreach(child IN LISTS imports_${id})
            list(APPEND dependencies "${name_${child}}:${version_${child}}")
        endforeach()
        list(SORT dependencies)
        if(id STREQUAL executable_id)
            gen_manifest_app("${ARG_NAME}" "${ARG_VERSION}"
                OUTPUT_DIRECTORY "${ARG_OUTPUT_DIRECTORY}" ${dependencies})
        else()
            gen_manifest_lib("${name_${id}}" "${version_${id}}" ${dependencies})
        endif()
    endforeach()
    list(LENGTH modules count)
    math(EXPR count "${count} - 1")
    message(STATUS "Generated ${count} runtime DLL manifests; no DLLs copied")
endfunction()
